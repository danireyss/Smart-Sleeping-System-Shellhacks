# Copy to .env (gitignored) in the directory you run the backend from, and fill in.
# The backend loads .env on startup; real environment variables take precedence.

# Assistant (OpenAI-compatible API; Groq by default). Without a key and model the
# chat reports "Assistant offline" and everything else keeps working.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: require "Authorization: Bearer <token>" on POST /api/chat. Set this before
# exposing the board beyond your own network (e.g. Cloudflare Tunnel): chat spends the
# LLM quota.
# CHAT_TOKEN=

# Optional: light and sound from a USB webcam (needs ffmpeg, v4l-utils, alsa-utils on
# the board). Frames and audio are reduced to two numbers in memory and never stored.
# Find devices with `v4l2-ctl --list-devices` and `arecord -l`; leave empty to disable.
# CAMERA_DEVICE=/dev/video0
# CAMERA_EXPOSURE=300          # fixed exposure while measuring light (driver units)
# MIC_DEVICE=plughw:CARD=C920,DEV=0
# SOUND_CAL_DB=90              # dBFS -> estimated dB; calibrate against a sound meter app

# Optional
# DB_PATH=sleep-env.db
# BIND_ADDR=0.0.0.0:8080
# ROUTER_SOCKET=/var/run/arduino-router.sock
